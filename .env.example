# ==============================================================================
# STAFF ATTENDANCE PWA - ENVIRONMENT VARIABLES (100% FREE CLOUD SETUP)
# ==============================================================================

# Server Port
PORT=3001

# Supabase Free Cloud Database & Storage (https://supabase.com)
# 1. Create a 100% Free Supabase Project (500MB Postgres + 1GB Storage)
# 2. Go to Project Settings -> API
# 3. Copy Project URL and anon public / service_role API Key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Manager Security PIN (Default: 8080)
ADMIN_PIN=8080

# Node Environment
NODE_ENV=production
